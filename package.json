{
  "name": "tesuto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "prisma generate && next build",
    "start": "next start -p 3005",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "smoke": "bun run scripts/assertion-check.mjs && bun run scripts/smoke.mjs && bun run scripts/widget-smoke.mjs",
    "cleanup": "bun run scripts/cleanup.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.43.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.17.1",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.2.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5",
    "prisma": "^7.8.0",
    "react-doctor": "^0.9.13",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
