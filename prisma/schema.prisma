generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URL is supplied by prisma.config.ts (Prisma 7).
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  color           String
  githubLogin     String?  @map("github_login")
  role            String   @default("member") // admin | member
  title           String?
  bio             String?
  active          Boolean  @default(true)
  githubConnected Boolean  @default(false) @map("github_connected")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions        Session[]
  reportedTickets Ticket[]  @relation("TicketReporter")
  assignedTickets Ticket[]  @relation("TicketAssignee")
  comments        Comment[]
  docs            Doc[]

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  color       String
  token       String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  docs    Doc[]

  @@map("projects")
}

model Column {
  id          String  @id
  label       String
  description String?
  dot         String
  terminal    Boolean @default(false)
  limit       Int?
  order       Int     @default(0)

  @@map("columns")
}

model Ticket {
  id             String    @id @default(cuid())
  key            String
  projectId      String    @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         String    @default("backlog")
  priority       String    @default("medium")
  type           String    @default("bug")
  reporterId     String    @map("reporter_id")
  reporter       User      @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId     String?   @map("assignee_id")
  assignee       User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sourceUrl      String?   @map("source_url")
  domSnapshot    Json?     @map("dom_snapshot")
  screenshotUrl  String?   @map("screenshot_url")
  annotations    Json?
  context        Json?
  githubIssueUrl String?   @map("github_issue_url")
  order          Float     @default(0) // board sort key; fractional inserts allowed
  parentId       String?   @map("parent_id")
  parent         Ticket?   @relation("SubTickets", fields: [parentId], references: [id], onDelete: SetNull)
  children       Ticket[]  @relation("SubTickets")
  assignedAt     DateTime? @map("assigned_at")
  resolvedAt     DateTime? @map("resolved_at")
  events         Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  comments Comment[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([parentId])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("comments")
}

model Doc {
  id        String   @id @default(cuid())
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  icon      String   @default("file")
  content   String   @default("")
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("docs")
}
