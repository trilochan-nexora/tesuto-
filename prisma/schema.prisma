generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URL is supplied by prisma.config.ts (Prisma 7).
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  color           String
  githubLogin     String?  @map("github_login")
  /// OAuth access token, encrypted at rest with APP_SECRET. Never select into API payloads.
  githubToken     String?  @map("github_token")
  role            String   @default("member") // admin | member
  title           String?
  bio             String?
  active          Boolean  @default(true)
  githubConnected Boolean  @default(false) @map("github_connected")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions        Session[]
  reportedTickets Ticket[]  @relation("TicketReporter")
  assignedTickets Ticket[]  @relation("TicketAssignee")
  comments        Comment[]
  docs            Doc[]

  widgetLinks     WidgetLink[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the opaque token. Raw credentials are never stored at rest.
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   @default("app") // app | widget
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@index([scope, expiresAt])
  @@map("sessions")
}

/// Short-lived, single-use code used by the dashboard's email sign-in flow.
model LoginCode {
  email      String   @id
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("login_codes")
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  color       String
  token       String   @unique
  /// `owner/repo` that ticket sync opens issues in. Empty = sync disabled for this project.
  githubRepo  String?  @map("github_repo")
  createdAt   DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  docs    Doc[]
  columns Column[]

  @@map("projects")
}

/// Board columns are scoped per project, same as GitHub Projects: each board
/// keeps its own status set, so editing one project's columns never touches
/// another's.
model Column {
  id          String  @default(cuid())
  projectId   String  @map("project_id")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  description String?
  dot         String
  terminal    Boolean @default(false)
  limit       Int?
  order       Int     @default(0)

  @@id([projectId, id])
  @@map("columns")
}

model Ticket {
  id             String    @id @default(cuid())
  key            String
  projectId      String    @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         String    @default("backlog")
  priority       String    @default("medium")
  type           String    @default("bug")
  reporterId     String    @map("reporter_id")
  reporter       User      @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId     String?   @map("assignee_id")
  assignee       User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sourceUrl      String?   @map("source_url")
  domSnapshot    Json?     @map("dom_snapshot")
  screenshotUrl  String?   @map("screenshot_url")
  recordingUrl   String?   @map("recording_url")
  annotations    Json?
  context        Json?
  githubIssueUrl String?   @map("github_issue_url")
  order          Float     @default(0) // board sort key; fractional inserts allowed
  parentId       String?   @map("parent_id")
  parent         Ticket?   @relation("SubTickets", fields: [parentId], references: [id], onDelete: SetNull)
  children       Ticket[]  @relation("SubTickets")
  assignedAt     DateTime? @map("assigned_at")
  resolvedAt     DateTime? @map("resolved_at")
  events         Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  comments Comment[]
  media    MediaObject[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([parentId])
  @@map("tickets")
}

/// Binary ticket evidence lives outside Postgres; this row tracks ownership,
/// type and the opaque storage key used by the media service.
model MediaObject {
  id         String   @id
  storageKey String   @unique @map("storage_key")
  kind       String // screenshot | recording
  mimeType   String   @map("mime_type")
  size       Int
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("media_objects")
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("comments")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/**
 * Links a host-app identity (verified via signed assertion) to a Tesuto
 * user. `sam@hearth` proves who she is with the assertion, then verifies
 * once out-of-band (email code) that she owns `ram@tesuto` — from then on
 * her widget sessions act as ram. Unverified rows hold a pending code.
 */
model WidgetLink {
  hostEmail     String    @id @map("host_email")
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String?   @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")
  attempts      Int       @default(0)
  lastSentAt    DateTime? @map("last_sent_at")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("widget_links")
}

/// Prod API release notes pushed in from Hearth's CI (see /api/releases).
model Release {
  id         String   @id @default(cuid())
  version    String
  repo       String
  notesMd    String   @map("notes_md")
  releaseUrl String   @map("release_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("releases")
}

model Doc {
  id        String   @id @default(cuid())
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  icon      String   @default("file")
  content   String   @default("")
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("docs")
}
