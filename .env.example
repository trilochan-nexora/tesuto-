# Postgres for the Tesuto backend. Start it with `docker compose up -d`.
DATABASE_URL=postgresql://tesuto:tesuto@localhost:15433/tesuto

# Where Tesuto is reachable — links inside Slack/email and the GitHub OAuth
# callback are built from this. Defaults to http://localhost:3005.
APP_URL=http://localhost:3005

# Long random string (32+ characters, generated for this deployment). Protects
# login codes, encrypts GitHub OAuth tokens, and signs OAuth state.
APP_SECRET=change-me-to-a-long-random-string

# Persistent private volume for ticket screenshots and recordings. Required in
# production; do not place this directory under a public/static web root.
#MEDIA_STORAGE_DIR=/var/lib/tesuto/media

# Optional bearer secret for /api/maintenance/cleanup (32+ chars in production).
# When unset, run `bun run cleanup` from the host or scheduler instead.
#MAINTENANCE_SECRET=change-me-to-a-long-random-string

# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
# <APP_URL>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: override the callback url (defaults to <APP_URL>/api/github/callback).
#GITHUB_REDIRECT_URI=

# Slack incoming webhook — every ticket event (created/assigned/resolved/
# commented) posts here. Unset = Slack notifications off.
SLACK_WEBHOOK_URL=

# Resend handles both verified dashboard/widget sign-in and optional ticket
# notifications. Authentication fails closed when these values are absent.
RESEND_API_KEY=
EMAIL_FROM=Tesuto <tesuto@example.com>

# Optional, local development only: use a fixed six-digit login code instead
# of sending mail. Ignored when NODE_ENV=production.
#AUTH_DEV_CODE=123456

# Shared secret with the host app (Hearth) for widget identity assertions.
# Set to the SAME unique 32+ character random value on both sides. Required: the widget rejects
# all identity claims when it is absent. Assertions should expire within five
# minutes; unknown host users link an existing Tesuto account by email code.
TESUTO_WIDGET_SECRET=change-me-to-another-long-random-string

# Shared secret Hearth's CI sends as `X-Release-Secret` when it POSTs a new
# prod API release to /api/releases. Set to the SAME unique 32+ character random value on
# both sides. Unset = the endpoint rejects everything.
#HEARTH_RELEASES_SECRET=change-me-to-another-long-random-string
