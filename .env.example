# Postgres for the Tesuto backend. Start it with `docker compose up -d`.
DATABASE_URL=postgresql://tesuto:tesuto@localhost:15433/tesuto

# Where Tesuto is reachable — links inside Slack/email and the GitHub OAuth
# callback are built from this. Defaults to http://localhost:3005.
APP_URL=http://localhost:3005

# Long random string. Encrypts GitHub OAuth tokens at rest and signs the OAuth
# state nonce. Required to connect GitHub accounts.
APP_SECRET=change-me-to-a-long-random-string

# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
# <APP_URL>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: override the callback url (defaults to <APP_URL>/api/github/callback).
#GITHUB_REDIRECT_URI=

# Slack incoming webhook — every ticket event (created/assigned/resolved/
# commented) posts here. Unset = Slack notifications off.
SLACK_WEBHOOK_URL=

# Resend for email notifications (sent to the ticket assignee). Both must be
# set for email to send; unset = email off.
RESEND_API_KEY=
EMAIL_FROM=Tesuto <tesuto@example.com>

# Shared secret with the host app (Hearth) for widget identity assertions.
# Set to the SAME long random value on both sides. When set, the widget only
# trusts Hearth-signed identities and unknown host users must link a Tesuto
# account (email code) before they can file or comment. Unset = legacy
# trusted-host dev mode (any claimed name/email is accepted).
#TESUTO_WIDGET_SECRET=change-me-to-another-long-random-string

# Shared secret Hearth's CI sends as `X-Release-Secret` when it POSTs a new
# prod API release to /api/releases. Set to the SAME long random value on
# both sides. Unset = the endpoint rejects everything.
#HEARTH_RELEASES_SECRET=change-me-to-another-long-random-string
